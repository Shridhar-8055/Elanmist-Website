# Razorpay — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use rzp_test_ keys for testing, rzp_live_ keys in production.
# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Settings → Webhooks → secret you choose when adding
# https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# Google Sheets order log — see integrations/google-sheets/README.md
# The Apps Script web app URL (ends in /exec) and the SHARED_SECRET set in its Script properties.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxx/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=choose-another-long-random-string

# Cloudflare Turnstile (bot protection on checkout) — Cloudflare dashboard → Turnstile → Add widget.
# Leave both unset to disable. The site key is public (built into the page), the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Shiprocket — delivery tracking (see SHIPPING.md)
# A dedicated API user from Shiprocket → Settings → API → Configure (NOT your panel login).
SHIPROCKET_API_EMAIL=api-user@example.com
SHIPROCKET_API_PASSWORD=api-user-password
# Exact "Pickup Location" nickname from Shiprocket → Settings → Pickup Addresses, and its pincode.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=580024
# Token you choose for the tracking webhook (sent by Shiprocket as x-api-key).
SHIPROCKET_WEBHOOK_TOKEN=choose-a-long-random-string

# Order confirmation emails — Resend (https://resend.com → API Keys). Leave unset to disable.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be on a domain verified in Resend. Before the domain is verified you can test with
# Elanmist <onboarding@resend.dev>, which only delivers to your own Resend login email.
EMAIL_FROM=Elanmist <orders@elanmist.com>
EMAIL_REPLY_TO=support@elanmist.com
# Supabase — orders database, referral codes, coupons and the admin dashboard.
# Project Settings → API Keys. The secret (service_role) key must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Admin dashboard (/admin). A long password only the owner knows, and a random
# 32+ character signing secret. Changing either signs everyone out.
ADMIN_PASSWORD=choose-a-long-password
ADMIN_SESSION_SECRET=choose-a-random-string-of-at-least-32-characters

# Public site address used in email links (optional; defaults to the current domain).
SITE_URL=https://elanmist.com
