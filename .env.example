# Razorpay — https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use rzp_test_ keys for testing, rzp_live_ keys in production.
# Set these in Vercel → Project → Settings → Environment Variables. Never commit real values.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard → Settings → Webhooks → secret you choose when adding
# https://<your-domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string
